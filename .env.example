# Security (CHANGE THESE IN PRODUCTION!)
SESSION_SECRET="change-me-to-a-secure-random-string"
JWT_SECRET="change-me-to-a-secure-jwt-key"

# Database
# Use SQLite: DATABASE_URL_GO="sikompen.db"
# Use PostgreSQL: DATABASE_URL_GO="postgres://postgres:postgres@db:5432/sikompen?sslmode=disable"
DATABASE_URL_GO="postgres://postgres:postgres@db:5432/sikompen?sslmode=disable"

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sikompen

# Server
PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Email (optional — leave empty to disable email notifications)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=